{
  "name": "intellmeet",
  "private": true,
  "scripts": {
    "build": "npm --prefix server install",
    "start": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
